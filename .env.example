# Copy to .env on the NAS and replace every CHANGEME value.
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai
POSTGRES_PASSWORD=CHANGEME_USE_A_LONG_RANDOM_VALUE
DATABASE_URL=postgresql://legal_ai:CHANGEME_USE_A_LONG_RANDOM_VALUE@postgres:5432/legal_ai
QDRANT_URL=http://qdrant:6333
DOCUMENT_ROOT=/data/documents
APP_ADMIN_TOKEN=CHANGEME_USE_A_LONG_RANDOM_VALUE
TRUSTED_PROXY_NETWORKS=127.0.0.1,172.16.0.0/12
GEMINI_API_KEY=
CHECK_SCHEDULE=17 2 * * 1
TIMEZONE=Asia/Ho_Chi_Minh

